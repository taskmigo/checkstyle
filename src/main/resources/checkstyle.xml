<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="severity" value="error"/>

    <!-- Require every Java package to provide package-info.java. -->
    <module name="JavadocPackage"/>

    <module name="TreeWalker">
        <!-- Require existing package-info.java files to use JSpecify @NullMarked. -->
        <module name="JSpecifyNullMarked"/>
    </module>
</module>
